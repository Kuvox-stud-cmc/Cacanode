# Public HTTPS configuration. Point DEPLOY_DOMAIN to this droplet before starting Caddy.
APP_ENV=production
DEPLOY_DOMAIN=app.example.com
CADDY_ACME_EMAIL=admin@example.com
CORS_ORIGINS=https://app.example.com
PUBLIC_API_BASE_URL=https://app.example.com/api/v1
GRPC_CERT_DIR=/opt/cacanode/certs/grpc
AI_GRPC_PLAINTEXT=false
AI_GRPC_AUTHORITY_OVERRIDE=ai-api
PUBLIC_WIDGET_URL=https://app.example.com/widget/v1/cacanode-chat.js
ADMIN_WEB_URL=https://app.example.com
DEFAULT_LOCALE=vi-VN

# Generate independent high-entropy values. Keep URL passwords URL-safe.
POSTGRES_DB=cacanode
POSTGRES_USER=cacanode
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
RABBITMQ_USER=rag_user
RABBITMQ_PASSWORD=replace-with-a-long-url-safe-password
TOKEN_KEY=replace-with-at-least-32-random-bytes
PUBLIC_EVIDENCE_SIGNING_KEY=replace-with-at-least-32-random-bytes
WIDGET_PREVIEW_SIGNING_KEY=replace-with-at-least-32-random-bytes
INTEGRATION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
INTEGRATION_TOKEN_LEGACY_PEPPER=
INTEGRATION_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
INTEGRATION_SECRET_LEGACY_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
GRAPH_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes

# Optional authentication, business-read, embedding, and retrieval caches are disabled by default.
CACHE_ENABLED=false
CACHE_KEY_PREFIX=ccn:v1
CACHE_TTL_JITTER_PERCENT=10
INTEGRATION_TOKEN_CACHE_ENABLED=false
INTEGRATION_TOKEN_CACHE_TTL_SECONDS=60
BUSINESS_READ_CACHE_ENABLED=false
WIDGET_CONFIG_CACHE_ENABLED=false
WIDGET_CONFIG_CACHE_TTL_SECONDS=120
CUSTOMER_ANSWER_PROMPT_CACHE_ENABLED=false
CUSTOMER_ANSWER_PROMPT_CACHE_TTL_SECONDS=120
BILLING_ACCOUNT_CACHE_ENABLED=false
BILLING_ACCOUNT_CACHE_TTL_SECONDS=30
WORKSPACE_CACHE_ENABLED=false
WORKSPACE_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_ENABLED=false
DASHBOARD_CACHE_TTL_SECONDS=20
ANALYTICS_CACHE_ENABLED=false
ANALYTICS_CACHE_TTL_SECONDS=60
USER_DIRECTORY_CACHE_ENABLED=false
USER_DIRECTORY_CACHE_TTL_SECONDS=30
DOCUMENT_LIST_CACHE_ENABLED=false
DOCUMENT_LIST_CACHE_TTL_SECONDS=15
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_ENABLED=false
RETRIEVAL_CACHE_TTL_SECONDS=120
SEMANTIC_ANSWER_CACHE_MODE=off
SEMANTIC_ANSWER_CACHE_TTL_SECONDS=3600
SEMANTIC_ANSWER_CACHE_SIMILARITY_THRESHOLD=0.97
SEMANTIC_ANSWER_CACHE_COLLECTION=semantic_answer_cache_v1
SEMANTIC_ANSWER_CACHE_VECTOR_NAME=query_v1
SEMANTIC_ANSWER_CACHE_CANDIDATE_LIMIT=5
SEMANTIC_ANSWER_CACHE_CLEANUP_BATCH_SIZE=1000
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1

# Hosted answer generation and graph extraction. Ollama is embedding-only.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=o4-mini
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=90
GRAPH_EXTRACTION_MAX_OUTPUT_TOKENS=4096
GRAPH_EXTRACTION_BATCH_SIZE=4
GRAPH_EXTRACTION_REASONING_EFFORT=low

# One embedded document consumer. Do not enable the dedicated-workers profile at the same time.
WORKER_MODE=embedded
WORKER_KINDS=document
READINESS_REQUIRE_MODELS=true

# Local embedding model only; do not pull or configure Gemma 4 for generation.
TEXT_EMBEDDING_MODEL_ID=embeddinggemma
TEXT_EMBEDDING_DIMENSION=768
TEXT_EMBEDDING_BATCH_SIZE=16
TEXT_EMBEDDING_TIMEOUT_SECONDS=120
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# CPU multilingual reranker suitable for Vietnamese and English.
RERANKER_ENABLED=true
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
RERANKER_PLATFORM=linux/amd64
RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_THREADS=2
RERANKER_TIMEOUT_SECONDS=20

# Bounded retrieval for a 4-vCPU / 8-GB presentation deployment.
DENSE_CANDIDATE_COUNT=25
SPARSE_CANDIDATE_COUNT=25
GRAPH_CANDIDATE_COUNT=10
FUSION_CANDIDATE_COUNT=20
RRF_K=30
PRIMARY_CONTEXT_TOP_K=5
FINAL_CONTEXT_TOP_K=6
CONTEXT_DOCUMENT_SOFT_LIMIT=2
NEIGHBOR_EXPANSION_LIMIT=3

QDRANT_COLLECTION=knowledge_units_v2
QDRANT_DENSE_VECTOR_NAME=text_embeddinggemma_v1
QDRANT_SPARSE_VECTOR_NAME=text_bm25_v1
QDRANT_API_KEY=
SPARSE_MODEL_ID=Qdrant/bm25
SEAWEEDFS_BUCKET=cacanode
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_REGION=us-east-1

# Configure at least one provider for account messages and customer ticket confirmations.
SENDGRID_API_KEY=
BREVO_API_KEY=
FROM_EMAIL=no-reply@app.example.com
FROM_NAME=CacaNode
SUPPORT_EMAIL=support@app.example.com
VERIFICATION_LINK=https://app.example.com/verify-email
LOGIN_2FA_LINK=https://app.example.com/verify-login
INVITATION_LINK=https://app.example.com/accept-invitation
LOGIN_2FA_BYPASS_EMAILS=

# PayOS is off by default. Enable only after the public webhook URL is confirmed.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=https://app.example.com/api/v1/public/billing/payos/webhook
PAYOS_RETURN_URL=https://app.example.com/settings?tab=quota&payment=return
PAYOS_CANCEL_URL=https://app.example.com/settings?tab=quota&payment=cancel
BILLING_SALES_URL=mailto:sales@app.example.com
BILLING_CATALOG_VERSION=2026-07-15

COOKIE_SECURE=true
EXPIRY_MINS=15
EXPIRY_DAYS=30
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_STREAMS_PER_TENANT=10
DISABLE_EXTERNAL_TELEMETRY=true
LOG_LEVEL=INFO

# Runtime ceilings are intentionally overcommitted; Docker enforces each service independently.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=20
BUSINESS_API_MEMORY_LIMIT=1280m
AI_API_MEMORY_LIMIT=1536m
GRAPH_MEMORY_LIMIT=512m
RERANKER_MEMORY_LIMIT=1536m
OLLAMA_MEMORY_LIMIT=1280m
POSTGRES_MEMORY_LIMIT=768m
QDRANT_MEMORY_LIMIT=768m
RABBITMQ_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=256m
