# Shared local Compose configuration
APP_ENV=development
PUBLIC_API_BASE_URL=http://localhost/api/v1
PUBLIC_AI_API_BASE_URL=
PUBLIC_WIDGET_URL=http://localhost/widget/v1/cacanode-chat.js
ADMIN_WEB_URL=http://localhost:3000
DEFAULT_LOCALE=vi-VN
DEMO_CHATBOT_ID=00000000-0000-0000-0000-000000000005
DEMO_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000004

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cacanode
POSTGRES_USER=cacanode
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://rag_user:rag_password@rabbitmq:5672/

TOKEN_KEY=change-me-access
INTEGRATION_TOKEN_PEPPER=change-me-integration-pepper
WEBHOOK_ENCRYPTION_KEY=change-me-webhook-encryption-key
EXPIRY_MINS=15
EXPIRY_DAYS=30

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_units_v2
QDRANT_DENSE_VECTOR_NAME=text_embeddinggemma_v1
QDRANT_SPARSE_VECTOR_NAME=text_bm25_v1
KUZU_DATABASE_PATH=/data/kuzu/cacanode.kuzu
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs-s3:8333
SEAWEEDFS_BUCKET=cacanode
SEAWEEDFS_CONNECT_TIMEOUT_SECONDS=3
SEAWEEDFS_READ_TIMEOUT_SECONDS=30
SEAWEEDFS_MAX_ATTEMPTS=3

# Ollama model service inside Docker Compose
OLLAMA_PORT=11434
LLM_BASE_URL=http://ollama:11434/v1
LLM_INTERNAL_API_KEY=ollama
LLM_MODEL_ID=gemma4:12b
LLM_MAX_OUTPUT_TOKENS=128
LLM_TIMEOUT_SECONDS=90
LLM_USE_OLLAMA_NATIVE_CHAT=true
LLM_DISABLE_THINKING=true
TEXT_EMBEDDING_BASE_URL=http://ollama:11434
TEXT_EMBEDDING_MODEL_ID=embeddinggemma
TEXT_EMBEDDING_DIMENSION=768
TEXT_EMBEDDING_TIMEOUT_SECONDS=120
SPARSE_MODEL_ID=Qdrant/bm25
SPARSE_MODEL_CACHE_DIR=/models/fastembed
RERANKER_ENABLED=false
RERANKER_URL=http://reranker-service
RERANKER_PORT=8082
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
RERANKER_PLATFORM=linux/amd64
LOCAL_RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=10
DENSE_CANDIDATE_COUNT=40
SPARSE_CANDIDATE_COUNT=40
GRAPH_CANDIDATE_COUNT=20
FUSION_CANDIDATE_COUNT=30
RRF_K=30
PRIMARY_CONTEXT_TOP_K=5
FINAL_CONTEXT_TOP_K=8
CONTEXT_DOCUMENT_SOFT_LIMIT=2
NEIGHBOR_EXPANSION_LIMIT=3

# Optional NVIDIA vLLM/TEI profile settings
VLLM_MODEL_ID=
VLLM_API_KEY=change-me
TEI_MODEL_ID=google/embeddinggemma-300m
MODEL_REGISTRY_TOKEN=
MODEL_CACHE_DIR=/models
AI_DEVICE=cpu
AI_DTYPE=auto
INVITATION_LINK=http://localhost:3000/accept-invitation
