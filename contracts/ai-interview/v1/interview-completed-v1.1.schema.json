{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cacanode.local/contracts/ai-interview/v1/interview-completed-v1.1.schema.json",
  "title":"Interview completed v1.1","$ref":"#/$defs/event",
  "$defs":{
    "dimensions":{"type":"object","additionalProperties":false,"required":["comprehension","fluency","vocabulary","grammar","pronunciation"],"properties":{"comprehension":{"type":"number","minimum":1,"maximum":5},"fluency":{"type":"number","minimum":1,"maximum":5},"vocabulary":{"type":"number","minimum":1,"maximum":5},"grammar":{"type":"number","minimum":1,"maximum":5},"pronunciation":{"type":"number","minimum":1,"maximum":5}}},
    "evaluation":{"type":"object","additionalProperties":false,"required":["candidate_turn_id","accepted","rubric_score","english_dimensions"],"properties":{"candidate_turn_id":{"type":"string","format":"uuid"},"accepted":{"type":"boolean"},"rubric_score":{"type":["number","null"],"minimum":1,"maximum":5},"english_dimensions":{"oneOf":[{"$ref":"#/$defs/dimensions"},{"type":"null"}]}}},
    "question":{"type":"object","additionalProperties":false,"required":["section_id","question_id","section_kind","status","score","evaluations"],"properties":{"section_id":{"type":"string","format":"uuid"},"question_id":{"type":"string","format":"uuid"},"section_kind":{"enum":["CORE","ENGLISH_SCREEN"]},"status":{"enum":["COMPLETED","PARTIAL","UNANSWERED","SKIPPED"]},"score":{"type":["number","null"],"minimum":1,"maximum":5},"evaluations":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/evaluation"}}}},
    "section":{"type":"object","additionalProperties":false,"required":["section_id","kind","status"],"properties":{"section_id":{"type":"string","format":"uuid"},"kind":{"enum":["CORE","ENGLISH_SCREEN"]},"status":{"enum":["COMPLETED","PARTIAL","SKIPPED"]}}},
    "event":{"type":"object","additionalProperties":false,"required":["schema_version","event_id","event_type","occurred_at","tenant_id","aggregate_id","session_id","call_attempt_id","completion_reason","expected_turn_count","connected_seconds","partial","score_policy_version","overall_score","english_dimensions","english_band","section_results","question_results"],"properties":{"schema_version":{"const":"1.1"},"event_id":{"type":"string","format":"uuid"},"event_type":{"const":"interview.session.completed"},"occurred_at":{"type":"string","format":"date-time"},"tenant_id":{"type":"string","format":"uuid"},"aggregate_id":{"type":"string","format":"uuid"},"session_id":{"type":"string","format":"uuid"},"call_attempt_id":{"type":"string","format":"uuid"},"completion_reason":{"enum":["FINISHED","CANDIDATE_STOPPED","TIME_LIMIT","PARTIAL"]},"expected_turn_count":{"type":"integer","minimum":0,"maximum":500},"connected_seconds":{"type":"integer","minimum":0,"maximum":14400},"partial":{"type":"boolean"},"score_policy_version":{"const":"equal-core-questions-v1"},"overall_score":{"type":["number","null"],"minimum":0,"maximum":100,"multipleOf":0.01},"english_dimensions":{"oneOf":[{"$ref":"#/$defs/dimensions"},{"type":"null"}]},"english_band":{"type":["string","null"],"enum":["BASIC","CONVERSATIONAL","WORKING_PROFICIENCY","PROFESSIONAL",null]},"section_results":{"type":"array","maxItems":10,"items":{"$ref":"#/$defs/section"}},"question_results":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/question"}}}}
  }
}
