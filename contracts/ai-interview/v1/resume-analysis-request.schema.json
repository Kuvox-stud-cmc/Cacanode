{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cacanode.local/contracts/ai-interview/v1/resume-analysis-request.schema.json",
  "title": "Resume analysis request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "tenant_id", "aggregate_id", "analysis_id", "application_id", "document_id", "storage_key", "file_name", "content_type", "file_size_bytes", "requested_language_tag"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "interview.resume-analysis.requested"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "analysis_id": {"type": "string", "format": "uuid"},
    "application_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "storage_key": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^recruitment/"},
    "file_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "content_type": {"enum": ["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]},
    "file_size_bytes": {"type": "integer", "minimum": 1, "maximum": 20971520},
    "requested_language_tag": {"type": "string", "minLength": 2, "maxLength": 35}
  }
}
