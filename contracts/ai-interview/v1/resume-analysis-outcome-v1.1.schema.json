{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cacanode.local/contracts/ai-interview/v1/resume-analysis-outcome-v1.1.schema.json",
  "title":"Resume analysis outcome v1.1","type":"object","additionalProperties":false,
  "required":["schema_version","event_id","event_type","occurred_at","tenant_id","aggregate_id","analysis_id","application_id","cv_sha256","analysis_mode","policy_version","model_version","status","summary","evidence","skills","personalized_questions","error_code"],
  "properties":{
    "schema_version":{"const":"1.1"},"event_id":{"type":"string","format":"uuid"},
    "event_type":{"const":"interview.resume-analysis.outcome"},"occurred_at":{"type":"string","format":"date-time"},
    "tenant_id":{"type":"string","format":"uuid"},"aggregate_id":{"type":"string","format":"uuid"},
    "analysis_id":{"type":"string","format":"uuid"},"application_id":{"type":"string","format":"uuid"},
    "cv_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"analysis_mode":{"enum":["SUMMARY_ONLY","PERSONALIZED_QUESTIONS"]},
    "policy_version":{"type":"string","minLength":1,"maxLength":80},"model_version":{"type":"string","minLength":1,"maxLength":120},
    "status":{"enum":["COMPLETED","FAILED"]},"summary":{"type":["string","null"],"maxLength":4000},
    "evidence":{"type":"array","maxItems":250,"items":{"type":"object","additionalProperties":false,"required":["anchor_id","excerpt","source_location"],"properties":{"anchor_id":{"type":"string","minLength":1,"maxLength":80},"excerpt":{"type":"string","minLength":1,"maxLength":500},"source_location":{"type":"string","minLength":1,"maxLength":120}}}},
    "skills":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["name","evidence_anchor_ids"],"properties":{"name":{"type":"string","minLength":1,"maxLength":120},"evidence_anchor_ids":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":80}}}}},
    "personalized_questions":{"type":"array","maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["question_id","target_section_id","prompt","competency","rubric","evidence_anchor_ids"],"properties":{"question_id":{"type":"string","format":"uuid"},"target_section_id":{"type":"string","format":"uuid"},"prompt":{"type":"string","minLength":1,"maxLength":1000},"competency":{"type":"string","minLength":1,"maxLength":200},"rubric":{"type":"string","minLength":1,"maxLength":2000},"evidence_anchor_ids":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":80}}}}},
    "error_code":{"type":["string","null"],"minLength":1,"maxLength":100}
  },
  "oneOf":[
    {"properties":{"status":{"const":"COMPLETED"},"summary":{"type":"string","minLength":1},"error_code":{"type":"null"}}},
    {"properties":{"status":{"const":"FAILED"},"summary":{"type":"null"},"evidence":{"maxItems":0},"skills":{"maxItems":0},"personalized_questions":{"maxItems":0},"error_code":{"type":"string","minLength":1}}}
  ]
}
