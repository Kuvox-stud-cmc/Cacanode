{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cacanode.local/contracts/ai-interview/v1/provider-usage-v1.2.schema.json","title":"Interview provider usage v1.2","type":"object","additionalProperties":false,
