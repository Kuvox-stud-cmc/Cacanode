{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cacanode.local/contracts/ai-interview/v1/recording-ready.schema.json",
  "title": "Recruitment recording ready",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "tenant_id", "aggregate_id", "session_id", "call_attempt_id", "storage_key", "content_type", "size_bytes", "sha256", "retained_until"],
  "properties": {
    "schema_version": {"const": "1.0"}, "event_id": {"type": "string", "format": "uuid"}, "event_type": {"const": "recruitment.recording.ready"},
    "occurred_at": {"type": "string", "format": "date-time"}, "tenant_id": {"type": "string", "format": "uuid"}, "aggregate_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"}, "call_attempt_id": {"type": "string", "format": "uuid"},
    "storage_key": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^recruitment/"}, "content_type": {"enum": ["audio/mpeg", "audio/wav"]},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "retained_until": {"type": "string", "format": "date-time"}
  }
}
