# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
ADMIN_WEB_URL=http://localhost:3000
ALLOWED_ORIGIN_PATTERN_1=http://localhost:*
ALLOWED_ORIGIN_PATTERN_2=http://127.0.0.1:*
