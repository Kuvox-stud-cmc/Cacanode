# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
ADMIN_WEB_URL=http://localhost:3000
ALLOWED_ORIGIN_PATTERN_1=http://localhost:*
ALLOWED_ORIGIN_PATTERN_2=http://127.0.0.1:*
COOKIE_SECURE=false

# Authentication and authorization
TOKEN_KEY=change-me-access-token-signing-key-at-least-32-bytes
EXPIRY_MINS=15
EXPIRY_DAYS=30
INTEGRATION_TOKEN_PEPPER=development-integration-token-pepper
INTEGRATION_TOKEN_LEGACY_PEPPER=
INTEGRATION_SECRET_ENCRYPTION_KEY=change-me-integration-secret-encryption-key
INTEGRATION_SECRET_LEGACY_ENCRYPTION_KEY=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=cacanode
POSTGRES_USER=cacanode
POSTGRES_PASSWORD=change-me
POSTGRES_URL=jdbc:postgresql://localhost:15432/cacanode

# Redis and RabbitMQ
REDIS_URL=redis://localhost:16379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
CACHE_ENABLED=false
CACHE_KEY_PREFIX=ccn:v1
CACHE_TTL_JITTER_PERCENT=10
INTEGRATION_TOKEN_CACHE_ENABLED=false
INTEGRATION_TOKEN_CACHE_TTL_SECONDS=60
BUSINESS_READ_CACHE_ENABLED=false
WIDGET_CONFIG_CACHE_ENABLED=false
WIDGET_CONFIG_CACHE_TTL_SECONDS=120
CUSTOMER_ANSWER_PROMPT_CACHE_ENABLED=false
CUSTOMER_ANSWER_PROMPT_CACHE_TTL_SECONDS=120
BILLING_ACCOUNT_CACHE_ENABLED=false
BILLING_ACCOUNT_CACHE_TTL_SECONDS=30
WORKSPACE_CACHE_ENABLED=false
WORKSPACE_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_ENABLED=false
DASHBOARD_CACHE_TTL_SECONDS=20
ANALYTICS_CACHE_ENABLED=false
ANALYTICS_CACHE_TTL_SECONDS=60
USER_DIRECTORY_CACHE_ENABLED=false
USER_DIRECTORY_CACHE_TTL_SECONDS=30
DOCUMENT_LIST_CACHE_ENABLED=false
DOCUMENT_LIST_CACHE_TTL_SECONDS=15
EMBEDDING_CACHE_ENABLED=false
RETRIEVAL_CACHE_ENABLED=false
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:15673/

# S3-compatible object storage exposed by the root development Compose stack
SEAWEEDFS_S3_ENDPOINT=http://localhost:18333

# AI API integration
AI_GRPC_TARGET=localhost:50051
AI_GRPC_PLAINTEXT=true
AI_ANSWER_DEADLINE_SECONDS=100
AI_DOCUMENT_UNITS_DEADLINE_SECONDS=10
AI_DELETION_DEADLINE_SECONDS=15

# Email (account messages and customer ticket confirmations)
SENDGRID_API_KEY=
BREVO_API_KEY=
FROM_EMAIL=no-reply@cacanode.local
FROM_NAME=
VERIFICATION_LINK=http://localhost:3000/verify-email
LOGIN_2FA_LINK=http://localhost:3000/verify-login
SUPPORT_EMAIL=support@cacanode.local
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
MAX_VERIFICATION_RESEND_ATTEMPTS=5
LOGIN_2FA_EXPIRY_MINUTES=15

# Billing and PayOS
# Keep disabled until credentials are configured and the public webhook URL is confirmed in PayOS.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL="http://localhost:3000/settings?tab=quota&payment=return"
PAYOS_CANCEL_URL="http://localhost:3000/settings?tab=quota&payment=cancel"
BILLING_SALES_URL=mailto:sales@cacanode.com
BILLING_CATALOG_VERSION=2026-07-15

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
