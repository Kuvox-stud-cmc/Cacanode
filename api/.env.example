# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
ADMIN_WEB_URL=http://localhost:3000
ALLOWED_ORIGIN_PATTERN_1=http://localhost:*
ALLOWED_ORIGIN_PATTERN_2=http://127.0.0.1:*
COOKIE_SECURE=false

# Authentication and authorization
TOKEN_KEY=change-me-access
EXPIRY_MINS=15
EXPIRY_DAYS=30

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cacanode
POSTGRES_USER=cacanode
POSTGRES_PASSWORD=change-me
POSTGRES_URL=jdbc:postgresql://localhost:5432/cacanode

# Redis and RabbitMQ
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:5672/

# AI API integration
AI_API_GRPC_ADDRESS=static://localhost:50051
AI_API_BASE_URL=http://localhost:8000

# Email
SENDGRID_API_KEY=
BREVO_API_KEY=
FROM_EMAIL=no-reply@cacanode.local
FROM_NAME=
VERIFICATION_LINK=http://localhost:3000/verify-email
LOGIN_2FA_LINK=http://localhost:3000/verify-login
SUPPORT_EMAIL=support@cacanode.local
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
MAX_VERIFICATION_RESEND_ATTEMPTS=5
LOGIN_2FA_EXPIRY_MINUTES=15

# Billing and PayOS
# Keep disabled until credentials are configured and the public webhook URL is confirmed in PayOS.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL="http://localhost:3000/settings?tab=quota&payment=return"
PAYOS_CANCEL_URL="http://localhost:3000/settings?tab=quota&payment=cancel"
BILLING_SALES_URL=mailto:sales@cacanode.com
BILLING_CATALOG_VERSION=2026-07-15

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
