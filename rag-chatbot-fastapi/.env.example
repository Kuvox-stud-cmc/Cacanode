# ============================================
# Application Configuration
# ============================================

# Environment: development, staging, production
APP_ENV=development

# FastAPI server port
APP_PORT=8000

# CORS allowed origins (comma-separated, default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# LLM Configuration (Groq - default provider)
# ============================================

# Groq API key for LLM inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default LLM model (Groq model identifier)
LLM_MODEL=llama-3.3-70b-versatile

# ============================================
# Embedding Configuration (Voyage AI - default)
# ============================================

# Voyage AI API key for embeddings
VOYAGE_API_KEY=pa-your_voyage_api_key_here

# Default embedding model
EMBED_MODEL=voyage-3

# ============================================
# Vector Store (Qdrant)
# ============================================

# Qdrant server host
QDRANT_HOST=localhost

# Qdrant server port
QDRANT_PORT=6333

# ============================================
# Graph Database (Kuzu - embedded)
# ============================================

# Path to store Kuzu database files (one per tenant)
KUZU_DATA_PATH=./data/kuzu

# ============================================
# Cache (Redis)
# ============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# Message Queue (RabbitMQ)
# ============================================

# RabbitMQ connection URL
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:5672/

# ============================================
# Object Storage (SeaweedFS - S3-compatible)
# ============================================

# SeaweedFS S3 endpoint
STORAGE_ENDPOINT=http://localhost:8333

# S3 access key
STORAGE_ACCESS_KEY=your_access_key

# S3 secret key
STORAGE_SECRET_KEY=your_secret_key

# Default S3 bucket for document storage
STORAGE_BUCKET=documents

# ============================================
# JWT Authentication (Shared with Spring Boot)
# ============================================

# JWT signing secret (MUST match Spring Boot TOKEN_KEY)
JWT_SECRET=your_shared_jwt_secret_key_here

# JWT signing algorithm
JWT_ALGORITHM=HS256

# ============================================
# Spring Boot API Integration
# ============================================

# Spring Boot base URL for inter-service communication
SPRING_BASE_URL=http://localhost:8080
