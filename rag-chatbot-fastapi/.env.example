CARTESIA_ENGLISH_VOICE_ID=
CARTESIA_VIETNAMESE_VOICE_ID=
INTERVIEW_END_OF_UTTERANCE_SILENCE_MS=3000
INTERVIEW_TTS_OUTPUT_GAIN_DB=0
INTERVIEW_SMOKE_UTTERANCE_MAX_SECONDS=15
INTERVIEW_MEDIA_MAX_PAYLOAD_BYTES=65536
CV_ANALYSIS_POLICY_VERSION=cv-redaction-v1
CV_ANALYSIS_MODEL_VERSION=resume-analysis-v1
CV_ANALYSIS_MAX_EXTRACTED_CHARACTERS=50000
CV_ANALYSIS_MAX_EVIDENCE_SEGMENTS=250
