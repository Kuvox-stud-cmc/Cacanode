# Public API behavior
SSE_HEARTBEAT_SECONDS=15
IDEMPOTENCY_TTL_HOURS=24
PUBLIC_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_STREAMS_PER_TENANT=50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
