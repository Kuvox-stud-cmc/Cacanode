AI_DEVICE=cpu
AI_DTYPE=auto

# Upload limits
MAX_DOCUMENT_MB=20
MAX_IMAGE_MB=20
MAX_AUDIO_MB=200
MAX_VIDEO_MB=500
MALWARE_SCAN_ENABLED=false

# Retrieval
IMAGE_TOP_K=12
AUDIO_TOP_K=12
GRAPH_MAX_HOPS=3
DENSE_CANDIDATE_COUNT=40
SPARSE_CANDIDATE_COUNT=40
GRAPH_CANDIDATE_COUNT=20
FUSION_CANDIDATE_COUNT=30
RRF_K=30
