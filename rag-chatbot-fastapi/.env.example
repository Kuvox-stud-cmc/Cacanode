LLM_MODEL_ID=gemma4:12b
LLM_ADAPTER_ID=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=128
GRAPH_EXTRACTION_MAX_OUTPUT_TOKENS=25000
GRAPH_EXTRACTION_REASONING_EFFORT=low
GRAPH_EXTRACTION_BATCH_SIZE=4
LLM_TIMEOUT_SECONDS=90
LLM_USE_OLLAMA_NATIVE_CHAT=true
LLM_DISABLE_THINKING=true

# Text embeddings
TEXT_EMBEDDING_BASE_URL=http://localhost:11434
TEXT_EMBEDDING_MODEL_ID=embeddinggemma
TEXT_EMBEDDING_DIMENSION=768
TEXT_EMBEDDING_TIMEOUT_SECONDS=120
TEXT_EMBEDDING_BATCH_SIZE=32
SPARSE_MODEL_ID=Qdrant/bm25
SPARSE_MODEL_CACHE_DIR=./data/models/fastembed

# OpenAI (MVP production fallback)
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini

# Worker lifecycle
WORKER_MODE=embedded
WORKER_KINDS=document,ocr,asr,vision,audio,video
WORKER_POLL_INTERVAL_SECONDS=2

# Media model configuration
CLIP_MODEL_ID=
CLAP_MODEL_ID=
WHISPER_MODEL_ID=
OCR_ENGINE=paddleocr
OCR_LANGUAGE=vi
FFMPEG_BINARY=ffmpeg
MODEL_REGISTRY_TOKEN=
