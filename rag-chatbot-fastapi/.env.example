# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_LOCALE=vi-VN
READINESS_REQUIRE_MODELS=false

# Authentication and service integration
TOKEN_KEY=change-me-access
INTEGRATION_TOKEN_PEPPER=change-me-integration-pepper
BUSINESS_API_BASE_URL=http://localhost:8080

# PostgreSQL, cache, and queue
POSTGRES_URL=postgresql://cacanode:change-me@localhost:5432/cacanode
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:5672/

# Object storage
SEAWEEDFS_MASTER_URL=http://localhost:9333
SEAWEEDFS_FILER_URL=http://localhost:8888
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_BUCKET=cacanode

# Vector and graph storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_units_v1
QDRANT_TENANT_FIELD=tenant_id
QDRANT_KNOWLEDGE_BASE_FIELD=knowledge_base_id
KUZU_DATABASE_PATH=./data/kuzu/cacanode.kuzu
GRAPH_SERVICE_URL=http://localhost:8010

# Internal model serving
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_INTERNAL_API_KEY=ollama
LLM_MODEL_ID=gemma4:12b
LLM_ADAPTER_ID=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=128
LLM_TIMEOUT_SECONDS=90
LLM_USE_OLLAMA_NATIVE_CHAT=true
LLM_DISABLE_THINKING=true

# Text embeddings
TEXT_EMBEDDING_BASE_URL=http://localhost:11434
TEXT_EMBEDDING_MODEL_ID=embeddinggemma
TEXT_EMBEDDING_DIMENSION=768
TEXT_EMBEDDING_BATCH_SIZE=32

# OpenAI (MVP production fallback)
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini

# Worker lifecycle
WORKER_MODE=embedded
WORKER_KINDS=document,ocr,asr,vision,audio,video
WORKER_POLL_INTERVAL_SECONDS=2

# Media model configuration
CLIP_MODEL_ID=
CLAP_MODEL_ID=
WHISPER_MODEL_ID=
OCR_ENGINE=paddleocr
OCR_LANGUAGE=vi
FFMPEG_BINARY=ffmpeg
MODEL_REGISTRY_TOKEN=
MODEL_CACHE_DIR=./data/models
AI_DEVICE=cpu
AI_DTYPE=auto

# Upload limits
MAX_DOCUMENT_MB=20
MAX_IMAGE_MB=20
MAX_AUDIO_MB=200
MAX_VIDEO_MB=500
MALWARE_SCAN_ENABLED=false

# Retrieval
TEXT_TOP_K=20
IMAGE_TOP_K=12
AUDIO_TOP_K=12
GRAPH_MAX_HOPS=3
FINAL_CONTEXT_TOP_K=8
MIN_RETRIEVAL_CONFIDENCE=0.35
ENABLE_RERANKER=true
ENABLE_GENERAL_KNOWLEDGE=false

# Public API behavior
SSE_HEARTBEAT_SECONDS=15
IDEMPOTENCY_TTL_HOURS=24
PUBLIC_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_STREAMS_PER_TENANT=50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
DISABLE_EXTERNAL_TELEMETRY=true
